# ==============================================================================
# AvaFence - Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# NEVER commit real private keys or write them to .env.
# For Avalanche Mainnet deployment, use Foundry encrypted keystores:
#   cast wallet import <account_name> --interactive
# and deploy via:
#   forge script script/DeployAvaxGuard.s.sol --account <account_name> --rpc-url mainnet --broadcast
# ==============================================================================

# Network RPC Endpoints (Optional: defaults in foundry.toml are used if unset)
# AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc
# AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# Snowtrace API Key (Optional: for automated contract source verification)
# SNOWTRACE_API_KEY=
