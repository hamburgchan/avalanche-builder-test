# Avalanche Fuji Testnet Deployment Config
# 1. Copy to .env: cp .env.example .env
# 2. Fill in your testnet wallet private key (never use real mainnet keys with funds)
PRIVATE_KEY=your_fuji_private_key_here

# Fuji RPC
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Snowtrace verification (Optional)
SNOWTRACE_API_KEY=
